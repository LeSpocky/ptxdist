## SECTION=selinux

menuconfig POLICYCOREUTILS
	tristate
	prompt "policycoreutils               "
	select LIBSELINUX
	select LIBSEPOL
	select LIBSEMANAGE	if POLICYCOREUTILS_SEMODULE
	select LIBSEMANAGE	if POLICYCOREUTILS_SETSEBOOL
	select AUDIT		if POLICYCOREUTILS_AUDIT
	select PAM		if GLOBAL_PAM
	select LIBC_CRYPT	if !GLOBAL_PAM && (POLICYCOREUTILS_NEWROLE || POLICYCOREUTILS_RUN_INIT)
	select LIBC_DL		if POLICYCOREUTILS_RUN_INIT
	select LIBC_UTIL	if POLICYCOREUTILS_RUN_INIT
	select LIBC_PTHREAD	if POLICYCOREUTILS_SETFILES
	help
	  This package contains the core policy utilities that are required
	  for basic operation of an SELinux system.  These utilities include
	  load_policy to load policies, setfiles to label filesystems, newrole
	  to switch roles, and run_init to run /etc/init.d scripts in the proper
	  context.

if POLICYCOREUTILS

config POLICYCOREUTILS_AUDIT
	bool "audit support"
	help
	  Let newrole, run_init and setfiles log to the audit subsystem.

config POLICYCOREUTILS_LOAD_POLICY
	bool "load_policy"
	depends on !BUSYBOX_LOAD_POLICY || ALLYES

comment "busybox' load_policy is selected!"
	depends on BUSYBOX_LOAD_POLICY

config POLICYCOREUTILS_NEWROLE
	bool "newrole"

config POLICYCOREUTILS_NEWROLE_PAM_CFG
	bool "install /etc/pam.d/newrole"
	depends on POLICYCOREUTILS_NEWROLE && GLOBAL_PAM

config POLICYCOREUTILS_RUN_INIT
	bool "run_init/open_init_pty"

config POLICYCOREUTILS_RUN_INIT_PAM_CFG
	bool "install /etc/pam.d/run_init"
	depends on POLICYCOREUTILS_RUN_INIT && GLOBAL_PAM

config POLICYCOREUTILS_FIXFILES
	bool "fixfiles"
	help
	  fixfiles script needs a 'find' supporting -context, -delete,
	  -mindepth, -exec, -type, -print0 and parentheses, plus
	  'chcon --reference'. BusyBox can provide these with SELinux
	  support enabled, but 'fixfiles -N' additionally requires
	  -mount and -newermt only provided by GNU findutils.

config POLICYCOREUTILS_SECON
	bool "secon"

config POLICYCOREUTILS_SEMODULE
	bool "semodule/genhomedircon"

config POLICYCOREUTILS_SESTATUS
	bool "sestatus"
	depends on !BUSYBOX_SESTATUS || ALLYES

comment "busybox' sestatus is selected!"
	depends on BUSYBOX_SESTATUS

config POLICYCOREUTILS_SETFILES
	bool "setfiles/restorecon"
	depends on !BUSYBOX_SETFILES && !BUSYBOX_RESTORECON || ALLYES

comment "busybox' setfiles/restorecon is selected!"
	depends on BUSYBOX_SETFILES || BUSYBOX_RESTORECON

config POLICYCOREUTILS_SETSEBOOL
	bool "setsebool"
	depends on !BUSYBOX_SETSEBOOL || ALLYES

comment "busybox' setsebool is selected!"
	depends on BUSYBOX_SETSEBOOL

config POLICYCOREUTILS_UNSETFILES
	bool "unsetfiles"

endif
