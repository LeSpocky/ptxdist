config YAJL
	tristate
	prompt "yajl"
	select HOST_CMAKE
	help
	  Yet Another JSON Library.

	  A small, fast library for parsing JavaScript Object Notation (JSON).
	  It supports incremental parsing from a stream and leaves data
	  representation to higher level code.

