## SECTION=selinux

menuconfig LIBSELINUX
	tristate
	prompt "libselinux                    "
	select LIBC_DL
	select PCRE2
	select PCRE2_8
	select LIBSEPOL
	help
	  libselinux provides an API for SELinux applications to get and set
	  process and file security contexts and to obtain security policy
	  decisions. Required for any applications that use the SELinux
	  API.

if LIBSELINUX

config LIBSELINUX_UTILS
	bool "install utilities"

if LIBSELINUX_UTILS

config LIBSELINUX_GETENFORCE
	bool "getenforce"
	depends on !BUSYBOX_GETENFORCE || ALLYES

comment "busybox' getenforce is selected!"
	depends on BUSYBOX_GETENFORCE

config LIBSELINUX_GETSEBOOL
	bool "getsebool"
	depends on !BUSYBOX_GETSEBOOL || ALLYES

comment "busybox' getsebool is selected!"
	depends on BUSYBOX_GETSEBOOL

config LIBSELINUX_MATCHPATHCON
	bool "matchpathcon"
	depends on !BUSYBOX_MATCHPATHCON || ALLYES

comment "busybox' matchpathcon is selected!"
	depends on BUSYBOX_MATCHPATHCON

config LIBSELINUX_SELINUXENABLED
	bool "selinuxenabled"
	depends on !BUSYBOX_SELINUXENABLED || ALLYES

comment "busybox' selinuxenabled is selected!"
	depends on BUSYBOX_SELINUXENABLED

config LIBSELINUX_SETENFORCE
	bool "setenforce"
	depends on !BUSYBOX_SETENFORCE || ALLYES

comment "busybox' setenforce is selected!"
	depends on BUSYBOX_SETENFORCE

endif

endif
