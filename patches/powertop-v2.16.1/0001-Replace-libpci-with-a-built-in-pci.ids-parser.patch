 check_headers = [
   'fcntl.h',
   'libintl.h',
@@ -297,7 +288,6 @@ powertop_exe = executable('powertop',
   include_directories: [src_inc, include_directories('.')],
   dependencies: [
     ncursesw_dep,
-    pciutils_dep,
